{
    //
    //  PETSCII starter theme (#593)
    //
    //  Placeholder screens for the PETSCII starter menus
    //  (misc/menu_templates/petscii.in.hjson), drawn for a 40x25 Commodore
    //  screen. Only PETSCII sessions are given this theme ("emulation"
    //  below). The .seq files are generated by dev_util/petscii_art/ and are
    //  meant to be replaced: draw your own in a PETSCII editor, save them
    //  under the same names, and adjust the layouts below to match.
    //
    //  This copy lives outside art/themes/ on purpose: a PETSCII theme there
    //  would be given to PETSCII callers on every board, including boards
    //  without the PETSCII menus. "oputil.js config new" copies it into the
    //  themes directory when asked to.
    //
    info: {
        name: PETSCII Starter
        author: ENiGMA½ (placeholder art)
        group: enigma
        enabled: true
        emulation: petscii
    }

    customization: {
        defaults: {
            passwordChar: *

            dateTimeFormat: {
                short: MM/DD hh:mma
            }
        }

        menus: {
            petsciiMatrix: {
                mci: {
                    VM1: {
                        width: 20
                        height: 3
                        itemFormat: "|11{text}"
                        focusItemFormat: "|00|23{text}"
                    }
                }
            }

            petsciiLogin: {
                mci: {
                    ET1: {
                        width: 24
                    }
                    ET2: {
                        width: 24
                    }
                }
            }

            petsciiLoginTwoFactorAuthOTP: {
                mci: {
                    ET1: {
                        width: 12
                    }
                }
            }

            petsciiMainMenu: {
                mci: {
                    VM1: {
                        width: 24
                        height: 4
                        itemFormat: "|11{text}"
                        focusItemFormat: "|00|23{text}"
                    }
                }
            }

            //  columns match the headings in PLASTCALL.seq
            petsciiLoginLastCallers: {
                config: {
                    dateTimeFormat: MM/DD hh:mma
                }
                mci: {
                    VM1: {
                        height: 10
                        width: 38
                        itemFormat: "|15{userName:<15.14}|07{location:<10.9}|11{ts:<13.13}"
                    }
                }
            }

            petsciiLastCallers: {
                config: {
                    dateTimeFormat: MM/DD hh:mma
                }
                mci: {
                    VM1: {
                        height: 10
                        width: 38
                        itemFormat: "|15{userName:<15.14}|07{location:<10.9}|11{ts:<13.13}"
                    }
                }
            }

            //  columns match the headings in PWHOSON.seq
            petsciiWhosOnline: {
                mci: {
                    VM1: {
                        height: 10
                        width: 38
                        itemFormat: "|07{node:<5.4}|15{userName:<16.15}|11{action:<17.17}"
                    }
                }
            }

            petsciiMessageMenu: {
                mci: {
                    VM1: {
                        width: 24
                        height: 6
                        itemFormat: "|11{text}"
                        focusItemFormat: "|00|23{text}"
                    }
                }
            }

            //  columns match PMSGCONF.seq and PMSGAREA.seq
            petsciiMessageConfList: {
                mci: {
                    VM1: {
                        width: 36
                        height: 12
                        itemFormat: "|15{index:>2} |03{name:<33.32}"
                        focusItemFormat: "|00|23{index:>2} {name:<33.32}"
                    }
                    TL2: {
                        width: 36
                    }
                }
            }

            petsciiMessageAreaList: {
                mci: {
                    VM1: {
                        width: 36
                        height: 12
                        itemFormat: "|15{index:>2} |03{name:<33.32}"
                        focusItemFormat: "|00|23{index:>2} {name:<33.32}"
                    }
                    TL2: {
                        width: 36
                    }
                }
            }

            //  columns match the headings in PMSGLIST.seq
            petsciiMessageList: {
                config: {
                    dateTimeFormat: MM/DD/YY hh:mma
                    allViewsInfoFormat10: "|07{msgNumSelected}/{msgNumTotal} |15{fromUserName:<16.15} |11{ts}"
                }
                mci: {
                    VM1: {
                        height: 14
                        width: 38
                        itemFormat: "|15{msgNum:>3} |03{subject:<20.19}|11{fromUserName:<13.12}|15{newIndicator}"
                        focusItemFormat: "|00|23{msgNum:>3} {subject:<20.19}{fromUserName:<13.12}{newIndicator}"
                    }
                    TL10: {
                        width: 38
                    }
                }
            }

            //
            //  The full-screen editor menus have a form per part of the
            //  screen, so their layouts are given per form: 0 header, 1 body,
            //  2 editing footer, 3 editor menu, 4 reader footer, 5 quote
            //  builder.
            //
            petsciiMessageRead: {
                config: {
                    modTimestampFormat: MM/DD/YY hh:mma
                    quoteStyleLevel1: [
                        "|00|11"
                        "|00|08"
                        "|00|03"
                    ]
                    tearLineStyle: [
                        "|00|08"
                        "|00|02"
                    ]
                    originStyle: [
                        "|00|08"
                        "|00|06"
                        "|00|03"
                    ]
                }
                0: {
                    mci: {
                        TL1: {
                            width: 33
                            textOverflow: ...
                        }
                        TL2: {
                            width: 33
                            textOverflow: ...
                        }
                        TL3: {
                            width: 33
                            textOverflow: ...
                        }
                        TL5: {
                            width: 16
                        }
                        TL6: {
                            width: 4
                            justify: right
                        }
                        TL7: {
                            width: 4
                        }
                    }
                }
                1: {
                    mci: {
                        MT1: {
                            width: 38
                            height: 15
                            //  the match in focus is reversed (the default);
                            //  the others, which would be reversed too on a
                            //  PETSCII screen, are yellow instead
                            findMatchStyle: "\u001b[0;1;33m"
                        }
                    }
                }
                6: {
                    mci: {
                        ET1: {
                            width: 33
                        }
                    }
                }
                4: {
                    mci: {
                        HM1: {
                            styleSGR1: "|16|11"
                            styleSGR2: "|00|23"
                        }
                    }
                }
            }

            petsciiMessagePost: {
                0: {
                    mci: {
                        TL1: {
                            width: 33
                        }
                        ET2: {
                            width: 33
                        }
                        ET3: {
                            width: 33
                        }
                        TL4: {
                            width: 33
                        }
                    }
                }
                1: {
                    mci: {
                        MT1: {
                            width: 38
                            height: 15
                        }
                    }
                }
                3: {
                    mci: {
                        HM1: {
                            styleSGR1: "|16|11"
                            styleSGR2: "|00|23"
                        }
                    }
                }
                6: {
                    mci: {
                        ET1: {
                            width: 33
                        }
                    }
                }
            }

            petsciiMessageReply: {
                0: {
                    mci: {
                        TL1: {
                            width: 33
                        }
                        ET2: {
                            width: 33
                        }
                        ET3: {
                            width: 33
                        }
                        TL4: {
                            width: 33
                        }
                    }
                }
                1: {
                    mci: {
                        MT1: {
                            width: 38
                            height: 15
                        }
                    }
                }
                3: {
                    mci: {
                        HM1: {
                            styleSGR1: "|16|11"
                            styleSGR2: "|00|23"
                        }
                    }
                }
                6: {
                    mci: {
                        ET1: {
                            width: 33
                        }
                    }
                }
                //  rows match PMSGQUOT.seq
                5: {
                    mci: {
                        MT1: {
                            width: 38
                            height: 6
                        }
                        VM3: {
                            width: 38
                            height: 7
                            focusTextStyle: normal
                            //  the line in focus, reversed (the others keep
                            //  the colour of the art)
                            styleSGR2: "|00|23"
                        }
                    }
                }
            }

            //
            //  A pipe code for a foreground colour alone keeps the background
            //  before it, so an unfocused style after a focused (reversed)
            //  one names the black background too: |16, here and in the
            //  editor and reader menus (HM1) above.
            //
            petsciiLoginNewScanConfirm: {
                mci: {
                    TM1: {
                        styleSGR1: "|16|11"
                        styleSGR2: "|00|23"
                    }
                }
            }

            //  TL1 is new_scan's status line
            petsciiLoginNewScan: {
                config: {
                    scanStartFmt: "Scanning {areaName}..."
                    scanCompleteMsg: "Done."
                }
                mci: {
                    TL1: {
                        width: 36
                    }
                }
            }

            petsciiMessageNewScan: {
                config: {
                    scanStartFmt: "Scanning {areaName}..."
                    scanCompleteMsg: "Done."
                }
                mci: {
                    TL1: {
                        width: 36
                    }
                }
            }

            //  columns match the headings in PNEWMSGS.seq, as PMSGLIST
            petsciiNewScanMessageList: {
                config: {
                    dateTimeFormat: MM/DD/YY hh:mma
                    allViewsInfoFormat10: "|07{msgNumSelected}/{msgNumTotal} |15{fromUserName:<16.15} |11{ts}"
                }
                mci: {
                    VM1: {
                        height: 14
                        width: 38
                        itemFormat: "|15{msgNum:>3} |03{subject:<20.19}|11{fromUserName:<13.12}|15{newIndicator}"
                        focusItemFormat: "|00|23{msgNum:>3} {subject:<20.19}{fromUserName:<13.12}{newIndicator}"
                    }
                    TL10: {
                        width: 38
                    }
                }
            }
        }
    }
}
