{
    //
    //  PETSCII starter theme (#593)
    //
    //  Placeholder screens for the PETSCII starter menus
    //  (misc/menu_templates/petscii.in.hjson), drawn for a 40x25 Commodore
    //  screen. Only PETSCII sessions are given this theme ("emulation"
    //  below). The .seq files are generated by dev_util/petscii_art/ and are
    //  meant to be replaced: draw your own in a PETSCII editor, save them
    //  under the same names, and adjust the layouts below to match.
    //
    //  This copy lives outside art/themes/ on purpose: a PETSCII theme there
    //  would be given to PETSCII callers on every board, including boards
    //  without the PETSCII menus. "oputil.js config new" copies it into the
    //  themes directory when asked to.
    //
    info: {
        name: PETSCII Starter
        author: ENiGMA½ (placeholder art)
        group: enigma
        enabled: true
        emulation: petscii
    }

    customization: {
        defaults: {
            passwordChar: *

            dateTimeFormat: {
                short: MM/DD hh:mma
            }
        }

        menus: {
            petsciiMatrix: {
                mci: {
                    VM1: {
                        width: 20
                        height: 3
                        itemFormat: "|11{text}"
                        focusItemFormat: "|00|23{text}"
                    }
                }
            }

            petsciiLogin: {
                mci: {
                    ET1: {
                        width: 24
                    }
                    ET2: {
                        width: 24
                    }
                }
            }

            petsciiLoginTwoFactorAuthOTP: {
                mci: {
                    ET1: {
                        width: 12
                    }
                }
            }

            petsciiMainMenu: {
                mci: {
                    VM1: {
                        width: 24
                        height: 3
                        itemFormat: "|11{text}"
                        focusItemFormat: "|00|23{text}"
                    }
                }
            }

            //  columns match the headings in PLASTCALL.seq
            petsciiLoginLastCallers: {
                config: {
                    dateTimeFormat: MM/DD hh:mma
                }
                mci: {
                    VM1: {
                        height: 10
                        width: 38
                        itemFormat: "|15{userName:<15.14}|07{location:<10.9}|11{ts:<13.13}"
                    }
                }
            }

            petsciiLastCallers: {
                config: {
                    dateTimeFormat: MM/DD hh:mma
                }
                mci: {
                    VM1: {
                        height: 10
                        width: 38
                        itemFormat: "|15{userName:<15.14}|07{location:<10.9}|11{ts:<13.13}"
                    }
                }
            }

            //  columns match the headings in PWHOSON.seq
            petsciiWhosOnline: {
                mci: {
                    VM1: {
                        height: 10
                        width: 38
                        itemFormat: "|07{node:<5.4}|15{userName:<16.15}|11{action:<17.17}"
                    }
                }
            }
        }
    }
}
