{
    /*
        PETSCII starter menus (#593)
        ------------------------------- -   -
        A small menu tree for Commodore 64/128 style callers (PETSCII
        terminals), laid out for a 40x25 screen. It goes with the starter
        theme in misc/petscii_starter/, which holds the art (.seq files) and
        the view layouts for exactly these menus. "oputil.js config new" can
        set both up; see the PETSCII page in the documentation.

        A caller reaches this tree in one of two ways:

        *   The stock connect menu, telnetConnected, branches on the
            session's terminal emulation (the TE ACS code): a PETSCII caller
            goes on to petsciiMatrix, everyone else to the stock matrix.
            "config new" writes that branch; on an existing board, change
            telnetConnected's "next" by hand (see the documentation). The
            starter theme has CONNECT art, so the connect screen is PETSCII.
        *   A telnet listener of its own (loginServers.telnet.listeners in
            config.hjson) with "emulation: petscii" and
            "firstMenu: petsciiConnected".

        Every menu here is named "petscii..." and leads only to other menus
        in this file, or ends the session: a PETSCII caller never lands on a
        stock (80 column ANSI) menu, which a PETSCII theme has no art for.

        New user applications are not offered here yet: "apply" tells the
        caller to apply from an ANSI terminal.

        Messages (the new-message scan, conferences, areas, the message
        list, reading, replying and posting with the full-screen editor)
        are here; search, private mail and the file base are not yet.

        A Commodore keyboard has no Escape key: for a PETSCII caller F1 is
        Escape (the PETSCII input decoder reports it so), which is how the
        editor's menu is reached. Keep shortcuts to keys a Commodore
        keyboard has: not CTRL E, N, Q, R, S or T (those are colour, cursor
        and delete codes there), and not function keys other than F1.

        Extend it the same way as the stock menus: add a menu here, its art
        to the theme as a .seq file, and its view layout to the theme.
    */
    menus: {
        petsciiConnected: {
            desc: Connected
            art: CONNECT
            next: petsciiMatrix
            config: {
                nextTimeout: 2500
            }
        }

        petsciiMatrix: {
            desc: Login Matrix
            art: PMATRIX
            form: {
                0: {
                    mci: {
                        VM1: {
                            submit: true
                            focus: true
                            argName: navSelect
                            hotKeys: {
                                L: 0
                                A: 1
                                G: 2
                            }
                            hotKeySubmit: true
                            items: [
                                {
                                    text: "[L] login"
                                    data: login
                                }
                                {
                                    text: "[A] apply"
                                    data: apply
                                }
                                {
                                    text: "[G] log off"
                                    data: logoff
                                }
                            ]
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { navSelect: "login" }
                                action: @menu:petsciiLogin
                            }
                            {
                                value: { navSelect: "apply" }
                                action: @menu:petsciiApply
                            }
                            {
                                value: { navSelect: "logoff" }
                                action: @menu:petsciiLogoff
                            }
                        ]
                    }
                }
            }
        }

        //
        //  No new user application for PETSCII callers yet: say where to
        //  apply, then go back to the matrix.
        //
        petsciiApply: {
            desc: Apply
            art: PAPPLY
            config: {
                pause: petsciiPause
            }
        }

        petsciiLogin: {
            desc: Login
            art: PLOGIN
            next: [
                {
                    //  users with 2FA/OTP enabled *must* go through it
                    acs: AR2
                    next: petsciiLoginTwoFactorAuthOTPLoop
                }
                {
                    next: petsciiLoginLastCallers
                }
            ]
            config: {
                tooNodeMenu: petsciiLoginTooNode
                inactive: petsciiLoginAccountInactive
                disabled: petsciiLoginAccountDisabled
                locked: petsciiLoginAccountLocked
            }
            form: {
                0: {
                    mci: {
                        ET1: {
                            maxLength: @config:users.usernameMax
                            argName: username
                            focus: true
                        }
                        ET2: {
                            password: true
                            maxLength: @config:users.passwordMax
                            argName: password
                            submit: true
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { password: null }
                                action: @systemMethod:login
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            action: @systemMethod:prevMenu
                        }
                    ]
                }
            }
        }

        petsciiLoginTooNode: {
            desc: Already Logged In
            art: PTOONODE
            config: {
                pause: petsciiPause
            }
            next: petsciiLogoff
        }

        petsciiLoginAccountLocked: {
            desc: Account Locked
            art: PLOCKED
            config: {
                pause: petsciiPause
            }
            next: petsciiLogoff
        }

        petsciiLoginAccountDisabled: {
            desc: Account Disabled
            art: PDISABLED
            config: {
                pause: petsciiPause
            }
            next: petsciiLogoff
        }

        petsciiLoginAccountInactive: {
            desc: Inactive Account
            art: PINACTIVE
            config: {
                pause: petsciiPause
            }
            next: petsciiLogoff
        }

        //
        //  Empty menu to hold a 2FA/OTP login in a loop until the user
        //  authenticates or the system boots them, as the stock login does.
        //
        petsciiLoginTwoFactorAuthOTPLoop: {
            next: petsciiLoginTwoFactorAuthOTP
        }

        petsciiLoginTwoFactorAuthOTP: {
            desc: 2FA
            art: P2FAOTP
            next: petsciiLoginLastCallers
            form: {
                0: {
                    mci: {
                        ET1: {
                            argName: token
                            focus: true
                            submit: true
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { token: null }
                                action: @systemMethod:login2FA_OTP
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            //  no turning back at this point...
                            keys: [ "escape" ]
                            action: @systemMethod:logoff
                        }
                    ]
                }
            }
        }

        petsciiLoginLastCallers: {
            desc: Last Callers
            module: last_callers
            art: PLASTCALL
            config: {
                pause: petsciiPause
            }
            next: [
                {
                    //  calls >= 2
                    acs: NC2
                    next: petsciiLoginNewScanConfirm
                }
                {
                    //  new users: skip the new scan, as the stock login does
                    next: petsciiMainMenu
                }
            ]
        }

        //
        //  The new-message scan after login, as the stock login sequence
        //  offers it (fullLoginSequenceNewScanConfirm), for messages only:
        //  "skipFileBase" keeps new_scan out of the file base, which has no
        //  PETSCII menus. Every menu the scan can go to is named here.
        //
        petsciiLoginNewScanConfirm: {
            desc: Logging In
            art: PNSCONF
            form: {
                0: {
                    mci: {
                        TM1: {
                            argName: promptValue
                            items: [ "yes", "no" ]
                            focus: true
                            submit: true
                            hotKeys: {
                                Y: 0
                                N: 1
                            }
                            hotKeySubmit: true
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { promptValue: 0 }
                                action: @menu:petsciiLoginNewScan
                            }
                            {
                                value: { promptValue: 1 }
                                action: @menu:petsciiMainMenu
                            }
                        ]
                    }
                }
            }
        }

        petsciiLoginNewScan: {
            desc: New Scan
            module: new_scan
            art: PNEWSCAN
            next: petsciiMainMenu
            config: {
                skipFileBase: true
                newScanMessageList: petsciiNewScanMessageList
                newScanActivityPubList: petsciiNewScanMessageList
                pause: petsciiPause
            }
        }

        petsciiMainMenu: {
            desc: Main Menu
            art: PMAIN
            form: {
                0: {
                    mci: {
                        VM1: {
                            submit: true
                            focus: true
                            argName: navSelect
                            hotKeys: {
                                M: 0
                                W: 1
                                L: 2
                                G: 3
                            }
                            hotKeySubmit: true
                            items: [
                                {
                                    text: "[M] messages"
                                    data: messages
                                }
                                {
                                    text: "[W] who's online"
                                    data: whosOnline
                                }
                                {
                                    text: "[L] last callers"
                                    data: lastCallers
                                }
                                {
                                    text: "[G] log off"
                                    data: logoff
                                }
                            ]
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { navSelect: "messages" }
                                action: @menu:petsciiMessageMenu
                            }
                            {
                                value: { navSelect: "whosOnline" }
                                action: @menu:petsciiWhosOnline
                            }
                            {
                                value: { navSelect: "lastCallers" }
                                action: @menu:petsciiLastCallers
                            }
                            {
                                value: { navSelect: "logoff" }
                                action: @menu:petsciiLogoff
                            }
                        ]
                    }
                }
            }
        }

        petsciiWhosOnline: {
            desc: Who's Online
            module: whos_online
            art: PWHOSON
            config: {
                pause: petsciiPause
            }
        }

        petsciiLastCallers: {
            desc: Last Callers
            module: last_callers
            art: PLASTCALL
            config: {
                pause: petsciiPause
            }
        }

        //
        //  Messages: pick a conference and an area, list the area's
        //  messages, read them, reply, and post. The stock equivalents are
        //  in message_base.in.hjson (messageBaseMainMenu and the menus it
        //  leads to); these are the same modules with 40 column art and
        //  only keys a Commodore keyboard has. The PETSCII input decoder
        //  reports F1 as Escape and F3 / F5 as Page Up / Page Down, so
        //  "escape" below is F1 (or ESC, where the terminal has one) and
        //  "page up" / "page down" are F3 / F5. Not here yet: search,
        //  private mail, uploads and downloads.
        //
        petsciiMessageMenu: {
            desc: Message Menu
            art: PMSGMENU
            form: {
                0: {
                    mci: {
                        VM1: {
                            submit: true
                            focus: true
                            argName: navSelect
                            hotKeys: {
                                N: 0
                                L: 1
                                P: 2
                                A: 3
                                J: 4
                                Q: 5
                            }
                            hotKeySubmit: true
                            items: [
                                {
                                    text: "[N] new messages"
                                    data: newScan
                                }
                                {
                                    text: "[L] list messages"
                                    data: list
                                }
                                {
                                    text: "[P] post a message"
                                    data: post
                                }
                                {
                                    text: "[A] change area"
                                    data: area
                                }
                                {
                                    text: "[J] join conference"
                                    data: conf
                                }
                                {
                                    text: "[Q] main menu"
                                    data: quit
                                }
                            ]
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { navSelect: "newScan" }
                                action: @menu:petsciiMessageNewScan
                            }
                            {
                                value: { navSelect: "list" }
                                action: @menu:petsciiMessageList
                            }
                            {
                                value: { navSelect: "post" }
                                action: @menu:petsciiMessagePost
                            }
                            {
                                value: { navSelect: "area" }
                                action: @menu:petsciiMessageAreaList
                            }
                            {
                                value: { navSelect: "conf" }
                                action: @menu:petsciiMessageConfList
                            }
                            {
                                value: { navSelect: "quit" }
                                action: @systemMethod:prevMenu
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            action: @systemMethod:prevMenu
                        }
                    ]
                }
            }
        }

        petsciiMessageConfList: {
            desc: Changing Confs
            art: PMSGCONF
            module: msg_conf_list
            config: {
                //  for a conference with art of its own
                changeConfPreArtMenu: petsciiMessageConfPreArt
            }
            form: {
                0: {
                    mci: {
                        VM1: {
                            focus: true
                            submit: true
                            argName: conf
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { conf: null }
                                action: @method:changeConference
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape", "q", "shift + q" ]
                            action: @systemMethod:prevMenu
                        }
                    ]
                }
            }
        }

        petsciiMessageAreaList: {
            desc: Message Area List
            art: PMSGAREA
            module: msg_area_list
            config: {
                //  for an area with art of its own
                changeAreaPreArtMenu: petsciiMessageAreaPreArt
            }
            form: {
                0: {
                    mci: {
                        VM1: {
                            focus: true
                            submit: true
                            argName: area
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { area: null }
                                action: @method:changeArea
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape", "q", "shift + q" ]
                            action: @systemMethod:prevMenu
                        }
                    ]
                }
            }
        }

        //
        //  A conference can name art of its own ("art" in its config.hjson
        //  entry), shown when a caller picks it. A PETSCII caller sees it
        //  only if the PETSCII theme has a .seq file of that name; otherwise
        //  nothing is shown ("optional"). An area can name art too, but the
        //  show_art module does not show area art yet (stock or PETSCII);
        //  the menu is here so that an area with art stays in this tree.
        //
        petsciiMessageConfPreArt: {
            desc: Viewing Art
            module: show_art
            config: {
                method: messageConf
                key: confTag
                optional: true
                pause: petsciiPause
                cls: true
                menuFlags: [ "noHistory" ]
            }
        }

        petsciiMessageAreaPreArt: {
            desc: Viewing Art
            module: show_art
            config: {
                method: messageArea
                key: areaTag
                optional: true
                pause: petsciiPause
                cls: true
                menuFlags: [ "noHistory" ]
            }
        }

        //  the new-message scan from the message menu; back there when done
        petsciiMessageNewScan: {
            desc: New Scan
            module: new_scan
            art: PNEWSCAN
            config: {
                skipFileBase: true
                newScanMessageList: petsciiNewScanMessageList
                newScanActivityPubList: petsciiNewScanMessageList
                pause: petsciiPause
            }
        }

        //
        //  An area with new messages, during the scan: Q goes on to the next
        //  area, X stops the scan, M marks the area read. (An ActivityPub
        //  area, which the stock tree shows in its own browser, is listed
        //  here too.)
        //
        petsciiNewScanMessageList: {
            desc: New Message List
            module: msg_list
            art: PNEWMSGS
            config: {
                menuViewPost: petsciiMessageRead
                menuNewPost: petsciiMessagePost
            }
            form: {
                0: {
                    mci: {
                        VM1: {
                            focus: true
                            submit: true
                            argName: messageIndex
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { messageIndex: null }
                                action: @method:selectMessage
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape", "q", "shift + q" ]
                            action: @systemMethod:prevMenu
                        }
                        {
                            keys: [ "x", "shift + x" ]
                            action: @method:fullExit
                        }
                        {
                            keys: [ "m", "shift + m" ]
                            action: @method:markAllRead
                        }
                        {
                            keys: [ "p", "shift + p" ]
                            action: @method:postNewMessage
                        }
                    ]
                }
            }
        }

        petsciiMessageList: {
            desc: Message List
            module: msg_list
            art: PMSGLIST
            config: {
                menuViewPost: petsciiMessageRead
                menuNewPost: petsciiMessagePost
            }
            form: {
                0: {
                    mci: {
                        VM1: {
                            focus: true
                            submit: true
                            argName: messageIndex
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { messageIndex: null }
                                action: @method:selectMessage
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape", "q", "shift + q" ]
                            action: @systemMethod:prevMenu
                        }
                        {
                            keys: [ "p", "shift + p" ]
                            action: @method:postNewMessage
                        }
                    ]
                }
            }
        }

        //
        //  The full-screen editor reading a message. Its screen is a header,
        //  the body and a footer, each its own art, and each its own form:
        //  0 header, 1 body, 4 the reader's footer. The help screen is the
        //  art named "help".
        //
        petsciiMessageRead: {
            desc: Viewing Message
            module: msg_area_view_fse
            config: {
                art: {
                    header: PMSGVHDR
                    body: PMSGBODY
                    footerView: PMSGVFTR
                    footerFind: PMSGFIND
                    help: PMSGVHLP
                }
                //  a reply to a sender with no account here (pre-login
                //  feedback); without this the module names a stock menu
                noReplyGhostSenderMenu: petsciiMessageNoReply
                editorMode: view
                editorType: area
            }
            form: {
                0: {
                    mci: {
                    }
                }
                1: {
                    mci: {
                        MT1: {
                            mode: preview
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: message
                                action: @method:editModeEscPressed
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            viewId: 1
                        }
                    ]
                }
                4: {
                    mci: {
                        HM1: {
                            items: [ "prev", "next", "reply", "quit", "help" ]
                            focusItemIndex: 1
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { 1: 0 }
                                action: @method:prevMessage
                            }
                            {
                                value: { 1: 1 }
                                action: @method:nextMessage
                            }
                            {
                                value: { 1: 2 }
                                action: @method:replyMessage
                                extraArgs: {
                                    menu: petsciiMessageReply
                                }
                            }
                            {
                                value: { 1: 3 }
                                action: @systemMethod:prevMenu
                            }
                            {
                                value: { 1: 4 }
                                action: @method:viewModeMenuHelp
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "p", "shift + p" ]
                            action: @method:prevMessage
                        }
                        {
                            keys: [ "n", "shift + n" ]
                            action: @method:nextMessage
                        }
                        {
                            keys: [ "r", "shift + r" ]
                            action: @method:replyMessage
                            extraArgs: {
                                menu: petsciiMessageReply
                            }
                        }
                        {
                            keys: [ "escape", "q", "shift + q" ]
                            action: @systemMethod:prevMenu
                        }
                        {
                            keys: [ "?" ]
                            action: @method:viewModeMenuHelp
                        }
                        {
                            //  page up / down are F3 / F5 for a PETSCII caller
                            keys: [ "down arrow", "up arrow", "page up", "page down" ]
                            action: @method:movementKeyPressed
                        }
                        {
                            keys: [ "ctrl + f" ]
                            action: @method:viewModeFind
                        }
                        {
                            //  the stock tree's CTRL N is a cursor key here
                            keys: [ "ctrl + g" ]
                            action: @method:viewModeFindNext
                        }
                        {
                            keys: [ "ctrl + p" ]
                            action: @method:viewModeFindPrev
                        }
                    ]
                }
                //  find: what to look for; F1 cancels and clears the matches
                6: {
                    mci: {
                        ET1: {
                            argName: query
                            maxLength: 100
                            focus: true
                        }
                    }
                    submit: {
                        1: [
                            {
                                value: { query: null }
                                action: @method:footerFindSubmit
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            action: @method:footerFindCancel
                        }
                    ]
                }
            }
        }

        //
        //  The full-screen editor writing a new message: forms 0 header
        //  (to, subject), 1 body, 2 the editing footer, 3 the editor menu
        //  that F1 opens (save, discard, help). There is no upload here, and
        //  no quick-save key: CTRL S is HOME on a Commodore keyboard.
        //
        petsciiMessagePost: {
            desc: Posting Message
            module: msg_area_post_fse
            config: {
                art: {
                    header: PMSGEHDR
                    body: PMSGBODY
                    footerEditor: PMSGEFTR
                    footerEditorMenu: PMSGEMFT
                    footerFind: PMSGFIND
                    help: PMSGEHLP
                }
                editorMode: edit
                editorType: area
                messageBasePostMessageNoAccess: petsciiMessagePostNoAccess
                //  so that leaving for the no access notice comes back to
                //  the menu before this one, not here
                menuFlags: [ "noHistory" ]
            }
            form: {
                0: {
                    mci: {
                        TL1: {
                            argName: from
                        }
                        ET2: {
                            argName: to
                            focus: true
                            text: All
                            validate: @systemMethod:validateNonEmpty
                            maxLength: 36
                        }
                        ET3: {
                            argName: subject
                            maxLength: 72
                            submit: true
                            validate: @systemMethod:validateNonEmpty
                        }
                    }
                    submit: {
                        3: [
                            {
                                value: { subject: null }
                                action: @method:headerSubmit
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            action: @method:headerEscapePressed
                        }
                    ]
                }
                1: {
                    mci: {
                        MT1: {
                            argName: message
                            mode: edit
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: message
                                action: @method:editModeEscPressed
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            viewId: 1
                        }
                        {
                            keys: [ "ctrl + o" ]
                            action: @method:editModeQuickHelp
                        }
                        {
                            keys: [ "ctrl + a" ]
                            action: @method:editModeChangeSubject
                        }
                        {
                            //  the editor's find goes to the first match (it
                            //  keeps no matches to step through while editing)
                            keys: [ "ctrl + f" ]
                            action: @method:editModeFind
                        }
                    ]
                }
                2: {
                    mci: {
                        SB1: {
                            width: 9
                            anchor: left
                            justify: left
                            separator: " "
                            panels: [
                                {
                                    name: mode
                                    width: 3
                                    justify: right
                                }
                                {
                                    name: pos
                                    width: 5
                                    justify: left
                                }
                            ]
                        }
                    }
                }
                3: {
                    mci: {
                        HM1: {
                            items: [ "save", "discard", "help" ]
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { 1: 0 }
                                action: @method:editModeMenuSave
                            }
                            {
                                value: { 1: 1 }
                                action: @systemMethod:prevMenu
                            }
                            {
                                value: { 1: 2 }
                                action: @method:editModeMenuHelp
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            action: @method:editModeEscPressed
                        }
                        {
                            keys: [ "s", "shift + s" ]
                            action: @method:editModeMenuSave
                        }
                        {
                            keys: [ "d", "shift + d" ]
                            action: @systemMethod:prevMenu
                        }
                        {
                            keys: [ "?", "h", "shift + h" ]
                            action: @method:editModeMenuHelp
                        }
                    ]
                }
                //  find: what to look for; F1 cancels
                6: {
                    mci: {
                        ET1: {
                            argName: query
                            maxLength: 100
                            focus: true
                        }
                    }
                    submit: {
                        1: [
                            {
                                value: { query: null }
                                action: @method:footerFindSubmit
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            action: @method:footerFindCancel
                        }
                    ]
                }
            }
        }

        //
        //  A reply: as petsciiMessagePost, with "quote" in the editor menu
        //  and form 5, the quote builder (MT1 the lines picked so far, VM3
        //  the message's lines to pick from), drawn below the header.
        //
        petsciiMessageReply: {
            desc: Replying to Message
            module: msg_area_post_fse
            config: {
                art: {
                    header: PMSGEHDR
                    body: PMSGBODY
                    quote: PMSGQUOT
                    footerEditor: PMSGEFTR
                    footerEditorMenu: PMSGEMFT
                    footerFind: PMSGFIND
                    help: PMSGEHLP
                }
                editorMode: edit
                editorType: area
                messageBasePostMessageNoAccess: petsciiMessagePostNoAccess
                //  so that leaving for the no access notice comes back to
                //  the menu before this one, not here
                menuFlags: [ "noHistory" ]
            }
            form: {
                0: {
                    mci: {
                        TL1: {
                            argName: from
                        }
                        ET2: {
                            argName: to
                            focus: true
                            validate: @systemMethod:validateNonEmpty
                            maxLength: 36
                        }
                        ET3: {
                            argName: subject
                            maxLength: 72
                            submit: true
                            validate: @systemMethod:validateNonEmpty
                        }
                    }
                    submit: {
                        3: [
                            {
                                value: { subject: null }
                                action: @method:headerSubmit
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            action: @method:headerEscapePressed
                        }
                    ]
                }
                1: {
                    mci: {
                        MT1: {
                            argName: message
                            mode: edit
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: message
                                action: @method:editModeEscPressed
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            viewId: 1
                        }
                        {
                            keys: [ "ctrl + o" ]
                            action: @method:editModeQuickHelp
                        }
                        {
                            keys: [ "ctrl + a" ]
                            action: @method:editModeChangeSubject
                        }
                        {
                            //  the editor's find goes to the first match (it
                            //  keeps no matches to step through while editing)
                            keys: [ "ctrl + f" ]
                            action: @method:editModeFind
                        }
                    ]
                }
                2: {
                    mci: {
                        SB1: {
                            width: 9
                            anchor: left
                            justify: left
                            separator: " "
                            panels: [
                                {
                                    name: mode
                                    width: 3
                                    justify: right
                                }
                                {
                                    name: pos
                                    width: 5
                                    justify: left
                                }
                            ]
                        }
                    }
                }
                3: {
                    mci: {
                        HM1: {
                            items: [ "save", "discard", "quote", "help" ]
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { 1: 0 }
                                action: @method:editModeMenuSave
                            }
                            {
                                value: { 1: 1 }
                                action: @systemMethod:prevMenu
                            }
                            {
                                value: { 1: 2 }
                                action: @method:editModeMenuQuote
                            }
                            {
                                value: { 1: 3 }
                                action: @method:editModeMenuHelp
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            action: @method:editModeEscPressed
                        }
                        {
                            keys: [ "s", "shift + s" ]
                            action: @method:editModeMenuSave
                        }
                        {
                            keys: [ "d", "shift + d" ]
                            action: @systemMethod:prevMenu
                        }
                        {
                            keys: [ "q", "shift + q" ]
                            action: @method:editModeMenuQuote
                        }
                        {
                            keys: [ "?", "h", "shift + h" ]
                            action: @method:editModeMenuHelp
                        }
                    ]
                }
                5: {
                    mci: {
                        MT1: {
                        }
                        VM3: {
                            argName: quote
                        }
                    }
                    submit: {
                        *: [
                            {
                                value: { quote: null }
                                action: @method:appendQuoteEntry
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            action: @method:quoteBuilderEscPressed
                        }
                    ]
                }
                //  find: what to look for; F1 cancels
                6: {
                    mci: {
                        ET1: {
                            argName: query
                            maxLength: 100
                            focus: true
                        }
                    }
                    submit: {
                        1: [
                            {
                                value: { query: null }
                                action: @method:footerFindSubmit
                            }
                        ]
                    }
                    actionKeys: [
                        {
                            keys: [ "escape" ]
                            action: @method:footerFindCancel
                        }
                    ]
                }
            }
        }

        petsciiMessagePostNoAccess: {
            desc: No Access
            art: PMSGNOACC
            config: {
                pause: petsciiPause
            }
        }

        petsciiMessageNoReply: {
            desc: No Reply - Ghost Sender
            art: PMSGNORPL
            config: {
                pause: petsciiPause
            }
        }

        petsciiLogoff: {
            desc: Logging Off
            art: PLOGOFF
            next: @systemMethod:logoff
        }
    }

    prompts: {
        //  The pause prompt for this tree; the stock one is drawn for ANSI
        petsciiPause: {
            art: PPAUSE
            config: {
                trailingLF: no
            }
        }
    }
}
