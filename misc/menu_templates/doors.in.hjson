{
	menus: {
		doorsMainMenu: {
            desc: Doors Menu
            art: DOORMNU
            prompt: menuCommand
            config: {
                interrupt: realtime
            }
            submit: [
                {
                    value: { command: "G" }
                    action: @menu:fullLogoffSequence
                }
                {
                    value: { command: "Q" }
                    action: @systemMethod:prevMenu
                }
                //
                //  The system supports many ways of launching doors including
                //  modules for DoorParty!, BBSLink, etc.
                //
                //  Below are some examples. See the documentation for more info.
                //
                {
                    value: { command: "ABRACADABRA" }
                    action: @menu:doorAbracadabraExample
                }
                {
                    value: { command: "TWBBSLINK" }
                    action: @menu:doorTradeWars2002BBSLinkExample
                }
                {
                    value: { command: "DP" }
                    action: @menu:doorPartyExample
                }
                //
                //  v86 native DOS emulation example
                //  See: doors/v86.md
                //
                {
                    value: { command: "MYGAME" }
                    action: @menu:doorMyGameV86
                }
                //
                //  Amiga (AmiExpress /X XIM) door in the built-in vAmiga emulator
                //  See: doors/amiga.md
                //
                {
                    value: { command: "MYAMIGA" }
                    action: @menu:doorMyGameAmiga
                }
            ]
        }

        //
        //  Local Door Example via abracadabra module
        //
        //  This example assumes launch_door.sh (which is passed args)
        //  launches the door.
        //
        doorAbracadabraExample: {
            desc: Abracadabra Example
            module: abracadabra
            config: {
                name: Example Door
                dropFileType: DORINFO
                cmd: /home/enigma/DOS/scripts/launch_door.sh
                args: [
                    "{node}",
                    "{dropFile}",
                    "{srvPort}",
                ],
                nodeMax: 1
                tooManyArt: DOORMANY
                io: socket

                //
                //  With io: socket, ENiGMA listens on 127.0.0.1 and hands the
                //  port to the launcher above as {srvPort}. Whatever connects
                //  first is given the caller's session, so the launcher (or the
                //  emulator it starts) must dial 127.0.0.1 -- spelled that way
                //  rather than "localhost", which can resolve to ::1 and miss
                //  the listener. A LAN address of this machine will not
                //  connect.
                //
                //  socketBindAddress is only for a door or emulator running on
                //  another machine; it exposes the caller's session to that
                //  network. See doors/scripts-and-binaries.md
                //
                //socketBindAddress: 10.0.0.5

                //
                //  What the drop file tells the door it is talking to:
                //  local, serial, or socket. Defaults to socket here because
                //  of io above; set it to serial if an emulator bridges the
                //  port to a COM port in a guest. See
                //  doors/scripts-and-binaries.md
                //
                //commType: serial
            }
        }

        //
        //  BBSLink Example (TradeWars 2000)
        //
        //  Register @ https://bbslink.net/
        //
        doorTradeWars2002BBSLinkExample: {
            desc: Playing TW 2002 (BBSLink)
            module: bbs_link
            config: {
                sysCode: XXXXXXXX
                authCode: XXXXXXXX
                schemeCode: XXXXXXXX
                door: tw
            }
        }

        //
        //  DoorParty! Example
        //
        //  Register @ http://throwbackbbs.com/
        //
        doorPartyExample: {
            desc: Using DoorParty!
            module: door_party
            config: {
                username: XXXXXXXX
                password: XXXXXXXX
                bbsTag: XX
            }
        }

        //
        //  Native x86/DOS door via v86 — no external emulator required.
        //
        //  Prerequisites:
        //    1. A raw FreeDOS disk image (.img) with your door(s) pre-installed.
        //       Compatible with QEMU and DOSBox-X for image setup.
        //    2. BIOS files in misc/v86_bios/ (downloaded automatically by install.sh).
        //
        //  Image AUTOEXEC.BAT / FDAUTO.BAT convention:
        //    CALL A:\RUN.BAT
        //    ECHO Shutting down, please wait... > COM1
        //    FDAPM POWEROFF
        //
        //  ENiGMA writes RUN.BAT to the A: floppy at runtime using the runBatch config
        //  below. This lets a single image host multiple doors — one entry per door,
        //  same image path.
        //
        //  See doors/v86.md for full setup instructions.
        //
        doorMyGameV86: {
            desc: My DOS Door (v86)
            module: v86_door
            config: {
                name: MyGame
                image: /path/to/images/freedos_doors.img
                dropFileType: DORINFO
                nodeMax: 1
                tooManyArt: DOORMANY
                runBatch:
                    '''
                    COPY A:\{dropFile} C:\DOORS\MYGAME\
                    C:\FOSSIL\X00.SYS
                    CD C:\DOORS\MYGAME
                    MYGAME.EXE {node}
                    ECHO Returning to BBS, please wait... > COM1
                    '''
                //  memoryMb: 64      // optional, default 64
                //  biosPath: /path/to/seabios.bin      // default: misc/v86_bios/seabios.bin
                //  vgaBiosPath: /path/to/vgabios.bin   // default: misc/v86_bios/vgabios.bin
            }
        }

        //
        //  Amiga door (AmiExpress /X "XIM") via the built-in vAmiga emulator --
        //  no external emulator, Kickstart or Workbench required.
        //
        //  Prerequisites:
        //    1. The enigma-vamiga npm package (installed with ENiGMA's dependencies);
        //       it bundles the AROS ROM.
        //    2. A door image (.hdf): a small FFS disk holding the host shim, the
        //       door library, a startup sequence and the door. Build one with
        //       ./oputil.js amiga-door create IMAGE DOORDIR
        //
        //  The door path is the Amiga path of the door inside the image.
        //
        //  A plain AmigaDOS program that uses its standard input and output
        //  (many Amiga BBS games) is a CLI door: set doorType: cli and pass
        //  what it needs on its command line with doorArgs.
        //
        //  Each session restores a snapshot of the booted machine, so starting
        //  is fast after the first caller. Writes the door makes are saved to
        //  the image after a clean exit, and while a door that saves is in use
        //  its image is held: other doors on the same image wait their turn
        //  (callers see tooManyArt). Give doors their own images to run them
        //  side by side.
        //
        //  See doors/amiga.md for full setup instructions.
        //
        doorMyGameAmiga: {
            desc: My Amiga Door
            module: amiga_door
            config: {
                name: MyAmigaGame
                image: /path/to/images/mygame.hdf
                door: BBS:Doors/MyGame/mygame.xim
                sharedState: true
                tooManyArt: DOORMANY
                //  doorArgs: -x                 // extra arguments after the node number
                //  doorType: cli                // a CLI (stdio) door instead of XIM
                //  doorType: aim                // an /X ARexx script (door: its path, e.g.
                //                               // BBS:Doors/KickBox.Rexx); the image needs
                //                               // your Workbench 3.1's ARexx (amiga-door create --workbench)
                //  consoleMode: raw             // CLI doors: cooked (default) or raw
                //  doorArgs: "{name} {timeleft}"  // CLI doors: the whole command line;
                //                               // also {node} and {level}
                //  rom: /path/to/kick31.rom     // default: bundled AROS ROM
                //  cpu: 68EC020                 // 68000 | 68010 | 68EC020
                //  fastKb: 8192                 // 0..8192
                //  font: topaz                  // SyncTERM font, or none
                //  minTimeLeftMinutes: 10
                //  notEnoughTimeArt: DOORTIME
                //  persist: true                // save the door's writes
                //  persistOn: [ok, carrier]     // save after these exits (default: ok and
                //                               // carrier for XIM doors, only ok for cli/aim)
                //  disconnectGraceSeconds: 35   // after a hangup, wait this long for the door
                //                               // to finish (keep above the shim's 30)
                //  amigaConsole: true           // translate Amiga console controls (default:
                //                               // true with a Latin-1 encoding)
            }
        }
	}
}