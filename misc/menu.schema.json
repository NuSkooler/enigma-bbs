{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/NuSkooler/enigma-bbs/master/misc/menu.schema.json",
    "title": "ENiGMA½ BBS menus",
    "$comment": "Generated by \"npm run build:schema\" from core/config/menu_schema.js. Do not edit by hand.\n\nDescribes the file as ENiGMA½ sees it, after loading: \"@reference:\",\n\"@environment:\" and \"@file:\" specs are substituted before this applies, so\nan unresolved spec in the raw file may read as a type error here while\nbeing perfectly correct.\n\nNothing is \"required\": a file may be a fragment completed by \"includes\",\nand in config.hjson's case by the defaults.\n\nWhere this says \"additionalProperties\": false, ENiGMA½ itself only warns.\nIt never refuses to boot over a key it does not recognise.",
    "type": "object",
    "properties": {
        "includes": {
            "description": "Additional menu files merged into this one.",
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "common": {
            "type": "object"
        },
        "menus": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "desc": {
                        "description": "Shown in Who's Online and wherever %MD is used.",
                        "type": "string"
                    },
                    "art": {},
                    "next": {},
                    "prompt": {
                        "description": "Name of an entry in the \"prompts\" section.",
                        "type": "string"
                    },
                    "submit": {},
                    "form": {
                        "type": "object"
                    },
                    "module": {
                        "description": "Module driving this menu; a bare name is a system module, or use @userModule:.",
                        "type": "string"
                    },
                    "config": {
                        "type": "object"
                    },
                    "font": {
                        "description": "SyncTERM style font for this menu's art; also accepted under config.",
                        "type": "string"
                    },
                    "runtime": {
                        "description": "Read at core/menu_module.js:644.",
                        "type": "object",
                        "properties": {
                            "autoNext": {
                                "type": "boolean"
                            }
                        },
                        "patternProperties": {
                            "^_": true
                        },
                        "additionalProperties": false
                    },
                    "youSubmittedFormat": {
                        "description": "bbs_list only; see docs/_docs/modding/bbs-list.md.",
                        "type": "string"
                    }
                },
                "patternProperties": {
                    "^_": true
                },
                "additionalProperties": false
            }
        },
        "prompts": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "art": {
                        "description": "Art file to display; required.",
                        "type": "string"
                    },
                    "mci": {
                        "type": "object"
                    },
                    "config": {
                        "type": "object"
                    },
                    "actionKeys": {}
                },
                "patternProperties": {
                    "^_": true
                },
                "additionalProperties": false
            }
        }
    },
    "patternProperties": {
        "^_": true
    },
    "additionalProperties": false
}
