{
    //
    //  ATASCII starter theme (#593)
    //
    //  Placeholder screens for the ATASCII starter menus
    //  (misc/menu_templates/atascii.in.hjson), drawn for a 40x24 Atari
    //  screen. Only ATASCII sessions are given this theme ("emulation"
    //  below). The .ata files are generated by dev_util/petscii_art/ and are
    //  meant to be replaced: draw your own in an ATASCII editor, save them
    //  under the same names, and adjust the layouts below to match.
    //
    //  An Atari screen has one colour. The only thing a view can show is
    //  inverse video, which the ATASCII output translator draws for SGR 7
    //  or any background colour other than black: "|00|23" (black on light
    //  grey) below is inverse video on an Atari, and focus is shown that
    //  way in every menu and list. Foreground colours and bold change
    //  nothing; "|16|07" (light grey on black) is plain text. A pipe code
    //  for a foreground colour alone keeps the background before it, so
    //  plain text names the black background (|16) too.
    //
    //  This copy lives outside art/themes/ on purpose: an ATASCII theme
    //  there would be given to ATASCII callers on every board, including
    //  boards without the ATASCII menus. "oputil.js config new" copies it
    //  into the themes directory when asked to.
    //
    info: {
        name: ATASCII Starter
        author: ENiGMA½ (placeholder art)
        group: enigma
        enabled: true
        emulation: atascii
    }

    customization: {
        defaults: {
            passwordChar: *

            dateTimeFormat: {
                short: MM/DD hh:mma
            }
        }

        menus: {
            atasciiMatrix: {
                mci: {
                    VM1: {
                        width: 20
                        height: 3
                        itemFormat: "|16|07{text}"
                        focusItemFormat: "|00|23{text}"
                    }
                }
            }

            atasciiLogin: {
                mci: {
                    ET1: {
                        width: 24
                    }
                    ET2: {
                        width: 24
                    }
                }
            }

            atasciiLoginTwoFactorAuthOTP: {
                mci: {
                    ET1: {
                        width: 12
                    }
                }
            }

            atasciiMainMenu: {
                mci: {
                    VM1: {
                        width: 24
                        height: 4
                        itemFormat: "|16|07{text}"
                        focusItemFormat: "|00|23{text}"
                    }
                }
            }

            //  columns match the headings in ALASTCALL.ata
            atasciiLoginLastCallers: {
                config: {
                    dateTimeFormat: MM/DD hh:mma
                }
                mci: {
                    VM1: {
                        height: 10
                        width: 38
                        itemFormat: "|16|07{userName:<15.14}{location:<10.9}{ts:<13.13}"
                    }
                }
            }

            atasciiLastCallers: {
                config: {
                    dateTimeFormat: MM/DD hh:mma
                }
                mci: {
                    VM1: {
                        height: 10
                        width: 38
                        itemFormat: "|16|07{userName:<15.14}{location:<10.9}{ts:<13.13}"
                    }
                }
            }

            //  columns match the headings in AWHOSON.ata
            atasciiWhosOnline: {
                mci: {
                    VM1: {
                        height: 10
                        width: 38
                        itemFormat: "|16|07{node:<5.4}{userName:<16.15}{action:<17.17}"
                    }
                }
            }

            atasciiMessageMenu: {
                mci: {
                    VM1: {
                        width: 24
                        height: 6
                        itemFormat: "|16|07{text}"
                        focusItemFormat: "|00|23{text}"
                    }
                }
            }

            //  columns match AMSGCONF.ata and AMSGAREA.ata
            atasciiMessageConfList: {
                mci: {
                    VM1: {
                        width: 36
                        height: 12
                        itemFormat: "|16|07{index:>2} {name:<33.32}"
                        focusItemFormat: "|00|23{index:>2} {name:<33.32}"
                    }
                    TL2: {
                        width: 36
                    }
                }
            }

            atasciiMessageAreaList: {
                mci: {
                    VM1: {
                        width: 36
                        height: 12
                        itemFormat: "|16|07{index:>2} {name:<33.32}"
                        focusItemFormat: "|00|23{index:>2} {name:<33.32}"
                    }
                    TL2: {
                        width: 36
                    }
                }
            }

            //  columns match the headings in AMSGLIST.ata
            atasciiMessageList: {
                config: {
                    dateTimeFormat: MM/DD/YY hh:mma
                    allViewsInfoFormat10: "|16|07{msgNumSelected}/{msgNumTotal} {fromUserName:<16.15} {ts}"
                }
                mci: {
                    VM1: {
                        height: 14
                        width: 38
                        itemFormat: "|16|07{msgNum:>3} {subject:<20.19}{fromUserName:<13.12}{newIndicator}"
                        focusItemFormat: "|00|23{msgNum:>3} {subject:<20.19}{fromUserName:<13.12}{newIndicator}"
                    }
                    TL10: {
                        width: 38
                    }
                }
            }

            //
            //  The full-screen editor menus have a form per part of the
            //  screen, so their layouts are given per form: 0 header, 1 body,
            //  2 editing footer, 3 editor menu, 4 reader footer, 5 quote
            //  builder.
            //
            atasciiMessageRead: {
                config: {
                    modTimestampFormat: MM/DD/YY hh:mma
                    //  no quote, tear line or origin styles: with one colour
                    //  there is nothing to tell them apart with
                }
                0: {
                    mci: {
                        TL1: {
                            width: 33
                            textOverflow: ...
                        }
                        TL2: {
                            width: 33
                            textOverflow: ...
                        }
                        TL3: {
                            width: 33
                            textOverflow: ...
                        }
                        TL5: {
                            width: 16
                        }
                        TL6: {
                            width: 4
                            justify: right
                        }
                        TL7: {
                            width: 4
                        }
                    }
                }
                1: {
                    mci: {
                        MT1: {
                            width: 38
                            height: 14
                            //  the match in focus is in inverse video (the
                            //  default); the others are left plain, as a
                            //  colour or dim style would not show on an
                            //  Atari and inverse would look like focus
                            findMatchStyle: "\u001b[0m"
                        }
                    }
                }
                6: {
                    mci: {
                        ET1: {
                            width: 33
                        }
                    }
                }
                4: {
                    mci: {
                        HM1: {
                            styleSGR1: "|16|07"
                            styleSGR2: "|00|23"
                        }
                    }
                }
            }

            atasciiMessagePost: {
                0: {
                    mci: {
                        TL1: {
                            width: 33
                        }
                        ET2: {
                            width: 33
                        }
                        ET3: {
                            width: 33
                        }
                        TL4: {
                            width: 33
                        }
                    }
                }
                1: {
                    mci: {
                        MT1: {
                            width: 38
                            height: 14
                        }
                    }
                }
                3: {
                    mci: {
                        HM1: {
                            styleSGR1: "|16|07"
                            styleSGR2: "|00|23"
                        }
                    }
                }
                6: {
                    mci: {
                        ET1: {
                            width: 33
                        }
                    }
                }
            }

            atasciiMessageReply: {
                0: {
                    mci: {
                        TL1: {
                            width: 33
                        }
                        ET2: {
                            width: 33
                        }
                        ET3: {
                            width: 33
                        }
                        TL4: {
                            width: 33
                        }
                    }
                }
                1: {
                    mci: {
                        MT1: {
                            width: 38
                            height: 14
                        }
                    }
                }
                3: {
                    mci: {
                        HM1: {
                            styleSGR1: "|16|07"
                            styleSGR2: "|00|23"
                        }
                    }
                }
                6: {
                    mci: {
                        ET1: {
                            width: 33
                        }
                    }
                }
                //  rows match AMSGQUOT.ata (see dev_util/petscii_art/atascii_screens.js)
                5: {
                    mci: {
                        MT1: {
                            width: 38
                            height: 6
                        }
                        VM3: {
                            width: 38
                            //  ends above the footer's first row (21)
                            height: 6
                            focusTextStyle: normal
                            //  the quote lines are plain strings: the view's
                            //  own styles mark the one in focus
                            styleSGR1: "|16|07"
                            styleSGR2: "|00|23"
                        }
                    }
                }
            }

            atasciiLoginNewScanConfirm: {
                mci: {
                    TM1: {
                        styleSGR1: "|16|07"
                        styleSGR2: "|00|23"
                    }
                }
            }

            //  TL1 is new_scan's status line
            atasciiLoginNewScan: {
                config: {
                    scanStartFmt: "Scanning {areaName}..."
                    scanCompleteMsg: "Done."
                }
                mci: {
                    TL1: {
                        width: 36
                    }
                }
            }

            atasciiMessageNewScan: {
                config: {
                    scanStartFmt: "Scanning {areaName}..."
                    scanCompleteMsg: "Done."
                }
                mci: {
                    TL1: {
                        width: 36
                    }
                }
            }

            //  columns match the headings in ANEWMSGS.ata, as AMSGLIST
            atasciiNewScanMessageList: {
                config: {
                    dateTimeFormat: MM/DD/YY hh:mma
                    allViewsInfoFormat10: "|16|07{msgNumSelected}/{msgNumTotal} {fromUserName:<16.15} {ts}"
                }
                mci: {
                    VM1: {
                        height: 14
                        width: 38
                        itemFormat: "|16|07{msgNum:>3} {subject:<20.19}{fromUserName:<13.12}{newIndicator}"
                        focusItemFormat: "|00|23{msgNum:>3} {subject:<20.19}{fromUserName:<13.12}{newIndicator}"
                    }
                    TL10: {
                        width: 38
                    }
                }
            }
        }
    }
}
