---
import AnsiArt from '../components/AnsiArt.astro';
import '../styles/enigma.css';

const install =
    'curl -o- https://raw.githubusercontent.com/NuSkooler/enigma-bbs/master/misc/install.sh | bash';

const features = [
    ['THREE WAYS IN', 'Telnet, SSH and both secure and non-secure WebSocket access built in, with unlimited nodes. Additional servers are easy to implement.'],
    ['FIDONET, NATIVELY', 'A native BinkP/1.1 mailer — inbound listener and outbound caller, no external binkd. Crashmail ships on export; a pull cycle keeps echo mail coming from quiet hubs.'],
    ['DOS DOORS THAT RUN', 'Native x86 emulation via v86 — LORD, PimpWars, TradeWars — with zero external dependencies. No QEMU, DOSBox or DOSEMU. Plus BBSLink, DoorParty and Exodus.'],
    ['INTERACTIVE FICTION', 'Z-Machine support runs Infocom classics natively in Node.js. Zork, Colossal Cave and hundreds more from the IF Archive. Versions 3, 4, 5 and 8.'],
    ['INDEXED FILE BASES', 'Gazelle-inspired file bases with fully indexed full-text search and #tags. FILE_ID.DIZ and NFO extraction on upload. Legacy X/Y/Z modem still works.'],
    ['ART AS IT WAS DRAWN', 'CP437 and UTF-8 with wide-character support, full SAUCE, SyncTERM-style fonts and baud emulation. View ANSI like the block gods intended.'],
    ['MAIL BEYOND FTN', 'Internet mail over IMAP/SMTP straight from the private message base, MRC relay chat, and experimental ActivityPub federation with WebFinger and NodeInfo2.'],
    ['READ IT ANYWHERE', 'Message bases exposed over Gopher and NNTP, plus a built-in web server with HTTP(S) for temporary download URLs and file browsing.'],
    ['YOURS TO SHAPE', 'HJSON configuration, menus and themes, Renegade-style pipe codes, MCI codes for lightbars and input areas, and JavaScript mods when config runs out.'],
    ['MODERN UNDERNEATH', 'PBKDF2-backed passwords, two-factor auth with one-time passwords, SQLite storage and structured Bunyan logging. Runs anywhere modern Node.js does.'],
    ['A FULL SCREEN EDITOR', 'ANSI art support, live cursor and mode indicators, inline find with Ctrl-F, and file upload straight into a message body.'],
    ['GAMIFIED', 'An expandable achievement system, and a remote-accessible Waiting For Caller dashboard for the sysop.'],
];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>ENiGMA½ BBS — modern BBS software with a nostalgic flair</title>
        <meta
            name="description"
            content="Modern bulletin board software with a nostalgic flair. Telnet, SSH and WebSocket in one Node.js process, plus FidoNet mail, indexed file bases, and DOS doors that actually run."
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
    </head>
    <body>
        <header class="nav">
            <a class="brand dos" href="/"><span class="brand__mark">█▄</span> ENiGMA½</a>
            <nav>
                <a href="/installation/installation-methods/">Docs</a>
                <a href="#features">Features</a>
                <a href="https://github.com/NuSkooler/enigma-bbs" class="dos nav__cta">GITHUB</a>
            </nav>
        </header>

        <section class="hero">
            <div class="hero__text">
                <p class="dos kicker">▀▀ BULLETIN BOARD SOFTWARE</p>
                <h1 class="dos wordmark">ENiGMA½<br /><span class="wordmark__b">BBS</span></h1>
                <p class="lede">
                    Modern bulletin board software with a nostalgic flair. Telnet, SSH and
                    WebSocket in one Node.js process — plus FidoNet mail, indexed file
                    bases, and DOS doors that actually run.
                </p>
                <p class="install"><span class="dos install__sigil">&gt;</span><code>{install}</code></p>
                <p class="cta">
                    <a class="dos cta__primary" href="/installation/installation-methods/">GET STARTED</a>
                    <a class="dos cta__secondary" href="/configuration/creating-config/">READ THE DOCS</a>
                </p>
            </div>
            <div class="hero__screen">
                <AnsiArt src="MMENU.ANS" alt="The ENiGMA½ main menu in the luciano_blocktronics theme" max="30px" />
                <p class="dos screen__caption">MMENU.ANS · luciano_blocktronics · shipped with ENiGMA½</p>
            </div>
        </section>

        <section class="features" id="features">
            <h2 class="dos section-head">WHAT YOU GET</h2>
            <ul class="grid">
                {features.map(([title, body]) => (
                    <li class="card">
                        <h3 class="dos card__title">█▄ {title}</h3>
                        <p class="card__body">{body}</p>
                    </li>
                ))}
            </ul>
        </section>

        <footer class="foot">
            <p class="dos">TELNET · SSH · WEBSOCKET · GOPHER · NNTP</p>
            <p class="dos">v0.5.1-beta · BSD-2-Clause</p>
            <p class="attrib">
                Type is <a href="https://int10h.org/oldschool-pc-fonts/">The Ultimate Oldschool
                PC Font Pack</a> by VileR, licensed
                <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>.
            </p>
        </footer>
    </body>
</html>

<style>
    body {
        margin: 0;
        background: #060806;
        color: #d9ded9;
        font-family: 'Source Sans 3', ui-sans-serif, system-ui, sans-serif;
    }
    a { color: #55ffff; text-decoration: none; }
    a:hover { color: #ffffff; }

    .nav {
        display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; padding: 0 2.5rem; height: 62px;
        border-bottom: 1px solid #1f261f; background: #0a0d0a;
    }
    .brand { font-size: 16px; line-height: 16px; color: #d9ded9; }
    .brand__mark { color: #55ff55; }
    .nav nav { display: flex; align-items: center; gap: 1.6rem; }
    .nav__cta {
        font-size: 16px; line-height: 16px;
        background: #55ffff; color: #060806; padding: 8px 14px;
    }
    .nav__cta:hover { color: #060806; }

    .hero {
        display: flex; flex-wrap: wrap; gap: 3rem; align-items: center;
        padding: 3.5rem 2.5rem 4rem;
        border-bottom: 1px solid #1f261f;
        background:
            radial-gradient(ellipse 640px 380px at 74% 46%, rgb(85 255 85 / 0.10), transparent 68%),
            radial-gradient(ellipse 520px 300px at 16% 30%, rgb(0 170 170 / 0.10), transparent 70%);
        position: relative;
    }
    /* Scanlines live on the hero only. The reading column gets none. */
    .hero::after {
        content: ''; position: absolute; inset: 0; pointer-events: none;
        background: repeating-linear-gradient(
            to bottom, rgb(0 0 0 / 0.3) 0, rgb(0 0 0 / 0.3) 1px, transparent 1px, transparent 3px);
        opacity: 0.5;
    }
    .hero__text { flex: 1 1 26rem; min-width: 0; max-width: 34rem; position: relative; z-index: 1; }
    .hero__screen { flex: 4 1 44rem; min-width: 0; position: relative; z-index: 1; }

    .kicker { font-size: 16px; line-height: 16px; color: #55ff55; margin: 0 0 1.4rem; }
    .wordmark {
        font-size: 80px; line-height: 80px; font-weight: normal; margin: 0 0 1.2rem;
        color: #55ff55;
        text-shadow: 0 0 26px rgb(85 255 85 / 0.45), 3px 3px 0 rgb(0 170 170 / 0.55);
    }
    .wordmark__b { color: #f2f6f2; text-shadow: 0 0 22px rgb(255 255 255 / 0.28); }
    .lede { font-size: 19px; line-height: 1.58; color: #a8b0a8; max-width: 34rem; margin: 0 0 1.6rem; text-wrap: pretty; }

    .install {
        display: flex; align-items: stretch; margin: 0 0 1.4rem; max-width: 40rem;
        border: 1px solid #2a332a; background: #000000; overflow-x: auto;
    }
    .install__sigil { font-size: 16px; line-height: 16px; color: #55ff55; padding: 13px 0 13px 14px; }
    .install code {
        font-family: 'IBM Plex Mono', ui-monospace, monospace; font-size: 12.5px;
        color: #d9ded9; padding: 12px 14px; white-space: nowrap;
    }

    .cta { display: flex; gap: 0.75rem; margin: 0; flex-wrap: wrap; }
    .cta__primary {
        font-size: 16px; line-height: 16px; background: #55ffff;
        color: #060806; padding: 14px 24px; box-shadow: 0 0 22px rgb(85 255 85 / 0.25);
    }
    .cta__primary:hover { color: #060806; }
    .cta__secondary { font-size: 16px; line-height: 16px; border: 1px solid #2a332a; color: #d9ded9; padding: 13px 24px; }
    .screen__caption { font-size: 16px; line-height: 16px; color: #4d554d; margin: 0.7rem 0 0; text-align: right; }

    .features { padding: 3.5rem 2.5rem; }
    .section-head { font-size: 16px; line-height: 16px; font-weight: normal; color: #55ff55; margin: 0 0 1.6rem; }
    .grid {
        list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    }
    .card { border: 1px solid #1f261f; background: #0d110d; padding: 1.4rem; }
    .card__title { font-size: 16px; line-height: 16px; font-weight: normal; color: #55ffff; margin: 0 0 0.75rem; }
    .card__body { font-size: 14.5px; line-height: 1.62; color: #8a928a; margin: 0; }

    .foot {
        display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; align-items: baseline;
        justify-content: space-between; padding: 1.5rem 2.5rem 2.2rem;
        border-top: 1px solid #1f261f; background: #0a0d0a;
    }
    .foot p { margin: 0; font-size: 16px; line-height: 16px; color: #4d554d; }
    .foot .attrib {
        flex-basis: 100%; font-family: 'Source Sans 3', system-ui, sans-serif;
        font-size: 12px; line-height: 1.5; color: #4d554d; margin-top: 0.6rem;
    }
</style>
