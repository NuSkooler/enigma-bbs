*.asc	eol=crlf
*.ASC	eol=crlf
*.ans	binary
*.ANS	binary
*.txt	eol=crlf
*.TXT	eol=crlf
*.diz	eol=crlf
*.DIZ	eol=crlf

# Don't mess with shell script line endings
*.sh text eol=lf

# Same thing for oputil.js which functions as a shell script
oputil.js text eol=lf

# The devcontainer is also unix
.devcontainer/Dockerfile text eol=lf
.devcontainer/devcontainer.json text eol=lf
# Real-world FTN area list fixtures - byte exact, never normalize line endings
test/fixtures/area_lists/** -text

# Webfonts are binary; never normalize line endings in them
*.woff binary
*.woff2 binary

# Native PETSCII art (Commodore sequential files) is binary
*.seq binary
*.SEQ binary

# Native ATASCII art (Atari 8-bit screen streams) is binary
*.ata binary
*.ATA binary

# RIPscrip art: CR LF line ends and ESC bytes, kept as they are
*.rip binary
*.RIP binary

# Keep development-only files out of `git archive` and GitHub's automatic
# source downloads, so a release holds what a board needs to run. Anything
# `npm ci`, startup, oputil or the installer reads stays out of this list.
/.devcontainer      export-ignore
/.github            export-ignore
/.husky             export-ignore
/.vscode            export-ignore
/.gitattributes     export-ignore
/.lintstagedrc.json export-ignore
/.prettierignore    export-ignore
/.prettierrc.json   export-ignore
/eslint.config.mjs  export-ignore
/dev_util           export-ignore
/docs               export-ignore
/test               export-ignore
/website            export-ignore
/DEV.md             export-ignore
/CONTRIBUTING.md    export-ignore
/RELEASING.md       export-ignore
